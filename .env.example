# Required. Needs access to the OpenAI Realtime API. Never commit the real value.
OPENAI_API_KEY=

# Optional
# Which deck to present: a folder under backend/decks/ containing deck.json.
DECK=cardiovex
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SESSION_MAX_SECONDS=600
SESSIONS_PER_IP_PER_HOUR=10
# If set, visitors must enter this code before a call starts.
DEMO_ACCESS_CODE=
