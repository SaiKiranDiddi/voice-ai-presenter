# Required. Needs access to the OpenAI Realtime API. Never commit the real value.
OPENAI_API_KEY=

# Optional
# Which deck to present: a folder under backend/decks/ containing deck.json.
DECK=cardiovex
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SESSION_MAX_SECONDS=600
SESSIONS_PER_IP_PER_HOUR=10
# Request the next slide block this many ms before the current one finishes speaking.
# Smaller = longer pause between blocks (0 waits for the end); very large (e.g. 99999) = no pause.
# Override per call for tuning with ?lead=500 in the URL.
NEXT_BLOCK_LEAD_MS=700
# If set, visitors must enter this code before a call starts.
DEMO_ACCESS_CODE=
# Voice visual in the side panel: wave (bar waveform, the default) or orb.
# Read when the frontend is built, so rebuild after changing it.
VITE_VOICE_VISUAL=wave
